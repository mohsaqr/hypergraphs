# How hypergraphs is tested on the Mac mini (ci VM). Run in the repo: mini-ci [job]
# Nestimate and cograph are installed from the local working trees.
node system
sibling ../Nestimate
sibling ../cograph
job test   Rscript -e 'testthat::test_local(stop_on_failure = TRUE)'
job check  Rscript -e 'r <- rcmdcheck::rcmdcheck(args = c("--no-manual", "--as-cran"), error_on = "never"); print(r); if (r$status != 0 || length(r$errors) || length(r$warnings)) quit(status = 1)'

# Prova Verify: capture of the equivalence tests, run as
#   mini-ci -- Rscript ../equivalence/hypergraphs/import-tests.R capture [file-regex]
# (the standing material git ignores is the copy kept in ../equivalence/hypergraphs/local; the driver copies it in)
include ../equivalence/hypergraphs/local
include ../equivalence/hypergraphs/import-tests.R
include ../equivalence/import-tests-common.R
include ../prova/.claude/worktrees/verify/reporters/verify-capture.R
fetch .ci/verify-capture

# The declared equivalence tests (tests/equivalence, the standard: ../equivalence/STANDARD.md): every
# comparison with a reference, recorded in .ci/verify-capture/capture.json. The Python references run in the
# virtualenv ~/equiv-py, named to the tests by HYPERGRAPHS_REFERENCE_PYTHON. Then, on the Mac:
#   sh ../equivalence/push.sh hypergraphs
job verify HYPERGRAPHS_REFERENCE_PYTHON="$HOME/equiv-py/bin/python" OMP_THREAD_LIMIT=2 Rscript -e 'source("tests/equivalence/helper-verify.R"); verify_tests(lib = "~/equiv-lib")'
